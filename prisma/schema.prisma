generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  password  String
  role      String   // ADMIN, CS, ADMIN_CS, NOC, MARKETING, TEKNISI, TROUBLESHOOTS, CREATOR_DIGITAL
  division  String?
  avatar    String?
  createdAt DateTime @default(now())
  
  ticketsClosed Ticket[] @relation("ClosedBy")
  contentCalendar ContentCalendar[]
  campaigns Campaign[]
  digitalLeads DigitalLead[]
}

model Ticket {
  id            Int      @id @default(autoincrement())
  customerName  String
  birthDate     DateTime?
  locationMap   String
  requestDate   DateTime @default(now())
  installedDate DateTime?
  package       String
  marketingName String
  teknisi       String?
  description   String?
  phoneNumber   String
  fotoRumah     String?
  hasPhoto      Boolean  @default(false)
  pengawalan    String?
  kmz           String?
  priority      String?
  pembayaran    String?
  status        String   @default("OPEN")
  statusOrder   Int      @default(0)
  
  closedById    Int?
  closedBy      User?    @relation("ClosedBy", fields: [closedById], references: [id])
  
  isolations    Isolation[]
  digitalLeads  DigitalLead[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([requestDate])
  @@index([marketingName])
  @@index([customerName])
  @@index([installedDate])
}

model Isolation {
  id              Int      @id @default(autoincrement())
  customerName    String
  customerAddress String?
  customerPhone   String?
  userEmail       String?
  activeDate      DateTime?
  marketing       String?
  radboox         String?
  price           Decimal? @db.Decimal(15, 2) // Harga paket
  isolationDate   DateTime @default(now())
  reason          String?
  status          String   @default("OPEN") // OPEN (Isolated), CLOSED (Restored)
  restorationDate DateTime?
  closeNote       String?
  closePhoto      String?
  teknisi         String?
  ticketDismantle String?
  isArchived      Boolean  @default(false)
  archivedAt      DateTime?
  importBatchAt   DateTime?
  importRowOrder  Int?
  
  ticketId        Int?
  ticket          Ticket?  @relation(fields: [ticketId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([customerName])
  @@index([marketing])
  @@index([isolationDate])
  @@index([radboox])
  @@index([isArchived])
}

model Priority {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String   // CSS color value or tailwind class hint
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Package {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatsappTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  content   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarketingActivity {
  id            Int      @id @default(autoincrement())
  date          DateTime @default(now())
  marketingName String
  activity      String
  notes         String?
  
  areaId        Int?
  area          CoveredArea? @relation("MarketingActivityArea1", fields: [areaId], references: [id])

  areaId2       Int?
  area2         CoveredArea? @relation("MarketingActivityArea2", fields: [areaId2], references: [id])

  areaId3       Int?
  area3         CoveredArea? @relation("MarketingActivityArea3", fields: [areaId3], references: [id])

  areaId4       Int?
  area4         CoveredArea? @relation("MarketingActivityArea4", fields: [areaId4], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@index([marketingName])
}

model CoveredArea {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?

  marketingActivities1 MarketingActivity[] @relation("MarketingActivityArea1")
  marketingActivities2 MarketingActivity[] @relation("MarketingActivityArea2")
  marketingActivities3 MarketingActivity[] @relation("MarketingActivityArea3")
  marketingActivities4 MarketingActivity[] @relation("MarketingActivityArea4")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model TroubleTicket {
  id           Int      @id @default(autoincrement())
  ticketCode   String?  @unique
  ticketPrefix String?
  ticketNumber Int?
  category     String   @default("TT")
  periodMonth  Int?
  periodYear   Int?
  customerName String
  user         String?
  waNumber     String
  mapsUrl      String?
  type         String
  ont          String?
  openedAt     DateTime @default(now())
  closedAt     DateTime?
  temporaryAt  DateTime?
  notes        String?
  problemCategory String?
  resolutionAction String?
  closeNotes   String?
  closePhotos  String[]
  closeBy      String?
  status       String   @default("OPEN")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([openedAt])
  @@index([category])
  @@index([problemCategory])
  @@index([resolutionAction])
}

// Creator Digital Models
model ContentCalendar {
  id          Int      @id @default(autoincrement())
  title       String
  content     String?
  contentType String   // POST, REEL, VIDEO, STORY, CAROUSEL
  platform    String   // INSTAGRAM, FACEBOOK, TIKTOK, YOUTUBE, WEBSITE
  status      String   @default("DRAFT") // DRAFT, SCHEDULED, PUBLISHED
  publishDate DateTime?
  creatorId   Int?
  creator     User?    @relation(fields: [creatorId], references: [id])
  notes       String?
  tags        String[] // Tag untuk kategori konten
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  analytics   ContentAnalytics[]

  @@index([status])
  @@index([platform])
  @@index([publishDate])
}

model Campaign {
  id               Int      @id @default(autoincrement())
  name             String
  description      String?
  startDate        DateTime
  endDate          DateTime?
  budget           Decimal? @db.Decimal(15, 2)
  status           String   @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED
  objectives       String[] // Tujuan campaign
  platforms        String[] // Platform yang digunakan
  createdById      Int?
  createdBy        User?    @relation(fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  digitalLeads     DigitalLead[]
  analytics        ContentAnalytics[]

  @@index([status])
  @@index([startDate])
}

model DigitalLead {
  id              Int      @id @default(autoincrement())
  name            String
  phone           String
  email           String?
  source          String   // INSTAGRAM, FACEBOOK, TIKTOK, WEBSITE, REFERENSI
  campaignId      Int?
  campaign        Campaign? @relation(fields: [campaignId], references: [id])
  message         String?
  status          String   @default("NEW") // NEW, CONTACTED, QUALIFIED, CONVERTED, LOST
  notes           String?
  convertedToTicketId Int?
  convertedToTicket Ticket? @relation(fields: [convertedToTicketId], references: [id])
  createdById     Int?
  createdBy       User?    @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([source])
  @@index([createdAt])
}

model ContentAnalytics {
  id            Int      @id @default(autoincrement())
  contentId     Int?
  content       ContentCalendar? @relation(fields: [contentId], references: [id])
  campaignId    Int?
  campaign      Campaign? @relation(fields: [campaignId], references: [id])
  platform      String
  date          DateTime
  reach         Int      @default(0)
  impressions   Int      @default(0)
  likes         Int      @default(0)
  comments      Int      @default(0)
  shares        Int      @default(0)
  saves         Int      @default(0)
  clicks        Int      @default(0)
  followersGain Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([date])
  @@index([platform])
  @@index([contentId])
  @@index([campaignId])
}

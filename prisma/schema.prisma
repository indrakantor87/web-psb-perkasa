generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  password  String
  role      String   // ADMIN, CS, NOC, MARKETING, TEKNISI
  createdAt DateTime @default(now())
  
  ticketsClosed Ticket[] @relation("ClosedBy")
}

model Ticket {
  id            Int      @id @default(autoincrement())
  customerName  String
  birthDate     DateTime?
  locationMap   String
  requestDate   DateTime @default(now())
  installedDate DateTime?
  package       String
  marketingName String
  teknisi       String?
  description   String?
  phoneNumber   String
  fotoRumah     String?
  hasPhoto      Boolean  @default(false)
  pengawalan    String?
  kmz           String?
  priority      String?
  pembayaran    String?
  status        String   @default("OPEN")
  statusOrder   Int      @default(0)
  
  closedById    Int?
  closedBy      User?    @relation("ClosedBy", fields: [closedById], references: [id])
  
  isolations    Isolation[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([requestDate])
  @@index([marketingName])
  @@index([customerName])
  @@index([installedDate])
}

model Isolation {
  id              Int      @id @default(autoincrement())
  customerName    String
  customerAddress String?
  customerPhone   String?
  userEmail       String?
  activeDate      DateTime?
  marketing       String?
  radboox         String?
  isolationDate   DateTime @default(now())
  reason          String?
  status          String   @default("OPEN") // OPEN (Isolated), CLOSED (Restored)
  restorationDate DateTime?
  teknisi         String?
  
  ticketId        Int?
  ticket          Ticket?  @relation(fields: [ticketId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([customerName])
  @@index([marketing])
  @@index([isolationDate])
  @@index([radboox])
}

model Priority {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String   // CSS color value or tailwind class hint
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatsappTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  content   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

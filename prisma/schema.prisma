generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  username    String   @unique
  password    String
  role        String   // ADMIN, CS, ADMIN_CS, NOC, MARKETING, TEKNISI, TROUBLESHOOTS, CREATOR_DIGITAL, HR, GENERAL_AFFAIR, OPERASIONAL
  division    String?
  position    String?
  subdivision String?
  avatar      String?
  createdAt   DateTime @default(now())
  
  ticketsClosed Ticket[] @relation("ClosedBy")
  employee Employee?
  troubleTicketsCreated TroubleTicket[]
  contentCalendar ContentCalendar[]
  campaigns Campaign[]
  digitalLeads DigitalLead[]
}

model Ticket {
  id            Int      @id @default(autoincrement())
  customerName  String
  birthDate     DateTime?
  locationMap   String
  requestDate   DateTime @default(now())
  installedDate DateTime?
  package       String
  marketingName String
  teknisi       String?
  description   String?
  phoneNumber   String
  fotoRumah     String?
  hasPhoto      Boolean  @default(false)
  pengawalan    String?
  kmz           String?
  priority      String?
  pembayaran    String?
  status        String   @default("OPEN")
  statusOrder   Int      @default(0)
  
  closedById    Int?
  closedBy      User?    @relation("ClosedBy", fields: [closedById], references: [id])

  createdById   Int?
  
  odpId         Int?
  odp           Odp?     @relation(fields: [odpId], references: [id])
  portNumber    Int?

  isolations    Isolation[]
  digitalLeads  DigitalLead[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([requestDate])
  @@index([marketingName])
  @@index([customerName])
  @@index([installedDate])
  @@index([createdById])
}

model Odp {
  id           Int      @id @default(autoincrement())
  nama_odp     String   @map("nama_odp")
  wilayah      String   @map("wilayah")
  lokasi       String   @map("lokasi")
  kapasitas    Int      @map("kapasitas")
  terpakai     Int      @map("terpakai")
  status_tiang String   @map("status_tiang")
  latitude     Float?   @map("latitude")
  longitude    Float?   @map("longitude")
  pop_id       Int?     @map("pop_id")
  pop          Pop?     @relation(fields: [pop_id], references: [id])
  odc_id       Int?     @map("odc_id")
  odc          Odc?     @relation(fields: [odc_id], references: [id])
  is_active    Boolean  @default(true) @map("is_active")
  created_at   DateTime @default(now()) @map("created_at")
  updated_at   DateTime @default(now()) @map("updated_at")

  tickets      Ticket[]

  @@map("psb_odp")
}

model Pop {
  id         Int      @id @default(autoincrement())
  nama_pop   String   @map("nama_pop")
  lokasi     String?  @map("lokasi")
  is_active  Boolean  @default(true) @map("is_active")
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @default(now()) @map("updated_at")

  odps       Odp[]
  odcs       Odc[]

  @@map("psb_pop")
}

model Odc {
  id         Int      @id @default(autoincrement())
  nama_odc   String   @map("nama_odc")
  pop_id     Int?     @map("pop_id")
  pop        Pop?     @relation(fields: [pop_id], references: [id])
  lokasi     String?  @map("lokasi")
  is_active  Boolean  @default(true) @map("is_active")
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @default(now()) @map("updated_at")

  odps       Odp[]

  @@map("psb_odc")
}

// --- Modul Jalur: peta jaringan fiber (jalur kabel & titik splice) ---

model Jalur {
  id         Int      @id @default(autoincrement())
  nama_jalur String?  @map("nama_jalur")
  jenis      String   @default("DISTRIBUSI") @map("jenis") // BACKBONE | DISTRIBUSI
  warna      String   @map("warna") // hex color, contoh: #00ffff
  path       Json     @map("path") // array of {lat,lng}
  pop_id     Int?     @map("pop_id")
  odc_id     Int?     @map("odc_id")
  keterangan String? @map("keterangan")
  created_by String?  @map("created_by")
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @default(now()) @map("updated_at")

  splices    Splice[]

  @@map("psb_jalur")
}

model Splice {
  id          Int      @id @default(autoincrement())
  nama        String   @map("nama") // contoh: S3, S4
  latitude    Float    @map("latitude")
  longitude   Float    @map("longitude")
  keterangan  String?  @map("keterangan")
  jalur_id    Int?     @map("jalur_id")
  kml_icon_style Json? @map("kml_icon_style")
  jalur       Jalur?   @relation(fields: [jalur_id], references: [id], onDelete: SetNull)
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @default(now()) @map("updated_at")

  @@map("psb_splice")
}

model Isolation {
  id              Int      @id @default(autoincrement())
  customerName    String
  customerAddress String?
  customerPhone   String?
  userEmail       String?
  activeDate      DateTime?
  marketing       String?
  radboox         String?
  price           Decimal? @db.Decimal(15, 2) // Harga paket
  isolationDate   DateTime @default(now())
  reason          String?
  status          String   @default("OPEN") // OPEN (Isolated), CLOSED (Restored)
  restorationDate DateTime?
  closeNote       String?
  closePhoto      String?
  teknisi         String?
  ticketDismantle String?
  isArchived      Boolean  @default(false)
  archivedAt      DateTime?
  importBatchAt   DateTime?
  importRowOrder  Int?
  createdById     Int?
  
  ticketId        Int?
  ticket          Ticket?  @relation(fields: [ticketId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([customerName])
  @@index([marketing])
  @@index([isolationDate])
  @@index([radboox])
  @@index([isArchived])
  @@index([createdById])
}

model Priority {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String   // CSS color value or tailwind class hint
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Package {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatsappTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  content   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarketingActivity {
  id            Int      @id @default(autoincrement())
  date          DateTime @default(now())
  marketingName String
  activity      String
  notes         String?
  flyer         Int      @default(0)
  sosialisasi   Int      @default(0)
  dataBase      Int      @default(0)
  event         Int      @default(0)
  total         Int      @default(0)
  
  areaId        Int?
  area          CoveredArea? @relation("MarketingActivityArea1", fields: [areaId], references: [id])

  areaId2       Int?
  area2         CoveredArea? @relation("MarketingActivityArea2", fields: [areaId2], references: [id])

  areaId3       Int?
  area3         CoveredArea? @relation("MarketingActivityArea3", fields: [areaId3], references: [id])

  areaId4       Int?
  area4         CoveredArea? @relation("MarketingActivityArea4", fields: [areaId4], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@index([marketingName])
}

model CoveredArea {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?

  marketingActivities1 MarketingActivity[] @relation("MarketingActivityArea1")
  marketingActivities2 MarketingActivity[] @relation("MarketingActivityArea2")
  marketingActivities3 MarketingActivity[] @relation("MarketingActivityArea3")
  marketingActivities4 MarketingActivity[] @relation("MarketingActivityArea4")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model TroubleTicket {
  id           Int      @id @default(autoincrement())
  ticketCode   String?  @unique
  ticketPrefix String?
  ticketNumber Int?
  category     String   @default("TT")
  periodMonth  Int?
  periodYear   Int?
  customerName String
  user         String?
  waNumber     String
  mapsUrl      String?
  type         String
  ont          String?
  paket        String?
  openedAt     DateTime @default(now())
  closedAt     DateTime?
  temporaryAt  DateTime?
  notes        String?
  problemCategory String?
  resolutionAction String?
  closeNotes   String?
  closePhotos  String[]
  closeBy      String?
  status       String   @default("OPEN")
  createdById  Int?
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  
  odpId        Int?
  portNumber   Int?
  sn           String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([openedAt])
  @@index([category])
  @@index([problemCategory])
  @@index([resolutionAction])
  @@index([paket])
  @@index([createdById])
}

// Creator Digital Models
model ContentCalendar {
  id          Int      @id @default(autoincrement())
  title       String
  content     String?
  contentType String   // POST, REEL, VIDEO, STORY, CAROUSEL
  platform    String   // INSTAGRAM, FACEBOOK, TIKTOK, YOUTUBE, WEBSITE
  status      String   @default("DRAFT") // DRAFT, SCHEDULED, PUBLISHED
  publishDate DateTime?
  creatorId   Int?
  creator     User?    @relation(fields: [creatorId], references: [id])
  notes       String?
  tags        String[] // Tag untuk kategori konten
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  analytics   ContentAnalytics[]

  @@index([status])
  @@index([platform])
  @@index([publishDate])
}

model Campaign {
  id               Int      @id @default(autoincrement())
  name             String
  description      String?
  startDate        DateTime
  endDate          DateTime?
  budget           Decimal? @db.Decimal(15, 2)
  status           String   @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED
  objectives       String[] // Tujuan campaign
  platforms        String[] // Platform yang digunakan
  createdById      Int?
  createdBy        User?    @relation(fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  digitalLeads     DigitalLead[]
  analytics        ContentAnalytics[]

  @@index([status])
  @@index([startDate])
}

model DigitalLead {
  id              Int      @id @default(autoincrement())
  name            String
  phone           String
  email           String?
  source          String   // INSTAGRAM, FACEBOOK, TIKTOK, WEBSITE, REFERENSI
  campaignId      Int?
  campaign        Campaign? @relation(fields: [campaignId], references: [id])
  message         String?
  status          String   @default("NEW") // NEW, CONTACTED, QUALIFIED, CONVERTED, LOST
  notes           String?
  convertedToTicketId Int?
  convertedToTicket Ticket? @relation(fields: [convertedToTicketId], references: [id])
  createdById     Int?
  createdBy       User?    @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([source])
  @@index([createdAt])
}

model ContentAnalytics {
  id            Int      @id @default(autoincrement())
  contentId     Int?
  content       ContentCalendar? @relation(fields: [contentId], references: [id])
  campaignId    Int?
  campaign      Campaign? @relation(fields: [campaignId], references: [id])
  platform      String
  date          DateTime
  reach         Int      @default(0)
  impressions   Int      @default(0)
  likes         Int      @default(0)
  comments      Int      @default(0)
  shares        Int      @default(0)
  saves         Int      @default(0)
  clicks        Int      @default(0)
  followersGain Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([date])
  @@index([platform])
  @@index([contentId])
  @@index([campaignId])
}

// --- Modul HR: absensi yang ditarik dari mesin fingerprint (ZKTeco) ---

model Employee {
  id               Int      @id @default(autoincrement())
  name             String
  department       String   @default("Pemasaran dan Pelayanan")
  position         String   @default("STAFF")
  subdivision      String?
  employmentStatus String   @default("Karyawan")
  joinDate         DateTime @default(now())
  fingerprintId    String?  @unique
  isActive         Boolean  @default(true)
  userId           Int?     @unique // Legacy relation; Marketing ownership now uses unique exact-name matching.
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attendances Attendance[]

  @@index([name])
}

model Attendance {
  id              Int       @id @default(autoincrement())
  employeeId      Int
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime
  checkIn         DateTime?
  checkOut        DateTime?
  status          String    @default("PRESENT")
  source          String    @default("FINGERPRINT_MACHINE")
  overtimeMinutes Int       @default(0)
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

model HrMachineSetting {
  id          Int      @id @default(autoincrement())
  machineIp   String   @default("")
  machinePort Int      @default(4370)
  updatedAt   DateTime @updatedAt
}

// --- Modul Daily Activity: rencana & laporan aktivitas harian karyawan ---

model DailyActivityItem {
  id               Int       @id @default(autoincrement())
  code             String    @unique
  activityDate     DateTime
  ownerUserId      Int?
  ownerName        String
  division         String
  subdivision      String?
  planningLevel    String    @default("STAFF")
  title            String
  detail           String?
  location         String?
  target           String?
  priorityLevel    String    @default("MEDIUM")
  executionStatus  String    @default("PLANNED")
  progressPercent  Int       @default(0)
  planNote         String?
  resultNote       String?
  obstacleNote     String?
  closedAt         DateTime?
  approvalStatus   String    @default("NONE")
  approvalNote     String?
  approvedByUserId Int?
  approvedByName   String?
  approvedAt       DateTime?
  createdById      Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([activityDate])
  @@index([ownerUserId])
  @@index([division])
  @@index([executionStatus])
  @@index([approvalStatus])
  @@map("psb_daily_activity_items")
}

model DailyActivityProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  userName       String
  division       String
  subdivision    String?
  planningLevel  String   @default("STAFF")
  approverUserId Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("psb_daily_activity_profiles")
}

model GmDailyReportSnapshot {
  id                     Int      @id @default(autoincrement())
  reportDate             DateTime @unique @db.Date
  totalPsbList           Int
  installationQueue      Int
  installedToday         Int
  totalCustomers         Int
  activeCustomers        Int
  isolationContinued     Int
  isolationNotContinued  Int
  dismantleOpen          Int
  dismantleClosed        Int
  customerDeclinePercent Float
  source                 String   @default("MANUAL")
  createdByUserId        Int?
  createdByName          String?
  updatedByUserId        Int?
  updatedByName          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("gm_daily_report_snapshots")
}
